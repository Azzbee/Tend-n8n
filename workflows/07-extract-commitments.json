{
  "id": "TendReview07",
  "name": "Tend 07: Extract Commitments (local AI, pending only)",
  "active": false,
  "nodes": [
    {
      "id": "run-fictional-demo",
      "name": "Run fictional demo",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "select-fictional-record",
      "name": "Select fictional record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [250, 0],
      "parameters": { "jsCode": "return [{json:{source_record_id:\"g1\"}}];" }
    },
    {
      "id": "prepare-local-ai-request",
      "name": "Prepare local AI request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 0],
      "parameters": {
        "url": "={{ 'http://host.docker.internal:18767/api/model-input?record_id=' + encodeURIComponent($json.source_record_id) }}",
        "options": { "timeout": 10000 }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "local-ai-extraction-basic-llm-chain-",
      "name": "Local AI extraction (Basic LLM Chain)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [760, 0],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.request.messages[1].content }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "={{ $json.request.messages[0].content }}"
            }
          ]
        },
        "batching": { "batchSize": 1 }
      }
    },
    {
      "id": "validate-quoted-model-result",
      "name": "Validate quoted model result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1030, 0],
      "parameters": {
        "jsCode": "const result=$input.first().json; const candidate=typeof result.text==='string'?JSON.parse(result.text):result; const record=$('Prepare local AI request').first().json.record; const keys=Object.keys(candidate);if(keys.length!==3||keys.some(k=>!['quote','action','suggested_due'].includes(k)))throw new Error('invalid model fields');if(typeof candidate.quote!=='string'||typeof candidate.action!=='string'||!record.body_text.includes(candidate.quote)||!candidate.quote.toLowerCase().includes(candidate.action.toLowerCase())||candidate.quote!==record.body_text.trim()||record.body_text.includes('\\n')||!/^I (?:will|promise to)\\b/i.test(candidate.quote))throw new Error('fabricated quote/action');if(candidate.suggested_due!==null && (typeof candidate.suggested_due!=='string'||!/^\\d{4}-\\d{2}-\\d{2}$/.test(candidate.suggested_due)||!candidate.quote.includes(candidate.suggested_due)))throw new Error('fabricated date');return [{json:{record,candidate}}];"
      }
    },
    {
      "id": "persist-pending-candidate",
      "name": "Persist pending candidate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 0],
      "parameters": {
        "url": "http://host.docker.internal:18767/api/candidates",
        "method": "POST",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": { "timeout": 10000 }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "local-ollama-chat-model",
      "name": "Local Ollama Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [760, 260],
      "parameters": {
        "model": "qwen3:0.6b",
        "options": {
          "temperature": 0,
          "format": "json",
          "think": false,
          "numCtx": 2048,
          "numPredict": 512
        }
      },
      "credentials": {
        "ollamaApi": {
          "id": "TendReviewLocalOllama",
          "name": "Tend review local Ollama (no key)"
        }
      }
    }
  ],
  "connections": {
