{
  "id": "TendGoogle13",
  "name": "Tend 13: Approved Google normalize and store",
  "active": false,
  "nodes": [
    {
      "id": "when-called-by-google-adapter",
      "name": "When called by Google adapter",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "parameters": { "inputSource": "passthrough" }
    },
    {
      "id": "validate-approved-raw-input",
      "name": "Validate approved raw input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [250, 0],
      "parameters": {
        "jsCode": "const x=$input.first().json;const c=x.context;if(c&&Date.now()+5000>c.deadline_at)throw new Error('storage budget exhausted; checkpoint unchanged');if(!c||!['gmail','calendar'].includes(c.source)||c.account_email!==c.profile_account_email||!x.record||typeof x.record.id!=='string'||!x.record.id||!(c.cursor===null||typeof c.cursor==='string'))throw new Error('invalid approved provider envelope');return [{json:x}];"
      }
    },
    {
      "id": "normalize-and-commit-approved-record",
      "name": "Normalize and commit approved record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 0],
      "parameters": {
        "url": "http://host.docker.internal:18768/api/live/sync",
        "method": "POST",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({source:$json.context.source,account_email:$json.context.account_email,profile_account_email:$json.context.profile_account_email,...($json.context.calendar_id?{calendar_id:$json.context.calendar_id}:{}),records:[$json.record],previous_cursor:$json.context.cursor,cursor:$json.context.cursor,complete:false,reconcile:false,window_start:$json.context.window_start,window_end:$json.context.window_end,seen_record_ids:[$json.record.id]}) }}",
        "options": { "timeout": 5000 },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": false,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_INTERNAL_API_CREDENTIAL_ID",
          "name": "CONFIGURE_INTERNAL_API_CREDENTIAL"
        }
      },
      "notes": "Bind a newly entered private Header Auth credential. No secret or real principal is included in this inactive export.",
      "notesInFlow": true
    },
    {
      "id": "return-committed-page-context",
      "name": "Return committed page context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 0],
      "parameters": {
        "jsCode": "const saved=$input.first().json;const x=$('Validate approved raw input').item.json;if(saved.error)throw new Error('record storage failed');return [{json:{context:x.context,source_record_id:x.record.id,committed:true}}];"
      }
    }
  ],
  "connections": {
    "When called by Google adapter": {
      "main": [
        [{ "node": "Validate approved raw input", "type": "main", "index": 0 }]
      ]
    },
    "Validate approved raw input": {
      "main": [
        [
          {
            "node": "Normalize and commit approved record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize and commit approved record": {
      "main": [
        [
          {
            "node": "Return committed page context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "timezone": "Europe/Paris",
    "saveManualExecutions": false
  },
  "tags": [],
  "pinData": {},
  "versionId": "00000000-0000-4000-8000-000000000013",
  "meta": { "templateCredsSetupCompleted": false }
}
