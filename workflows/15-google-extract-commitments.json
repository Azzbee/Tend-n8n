    {
      "id": "local-ai-extraction-basic-llm-chain-",
      "name": "Local AI extraction (Basic LLM Chain)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [1450, 0],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.request.messages[1].content }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "={{ $json.request.messages[0].content }}"
            }
          ]
        },
        "batching": { "batchSize": 1 }
      }
    },
    {
      "id": "validate-exact-authored-quote",
      "name": "Validate exact authored quote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1710, 0],
      "parameters": {
        "jsCode": "const isExplicitCommitment=function isExplicitCommitment(text) {\n  if (text.length > 262144)\n    return !1;\n  const value = text.trim().replace(/\\u2019/g, \"'\");\n  if (/[?]/.test(value) || /\\b(?:not|never|won't|would|could|might|maybe|perhaps|if|unless|provided|assuming|hopefully|pas|jamais|peut-\\u00EAtre|si|sauf|condition|\\u00E9ventuellement)\\b/iu.test(value))\n    return !1;\n  return /^J'(?:enverrai|appellerai|\\u00E9crirai|apporterai|organiserai)\\b/iu.test(value) || /^(?:I (?:will|promise to)|I'll) (?:send|share|review|call|write|prepare|deliver|finish|complete|check|confirm|book|arrange|introduce|follow up|reply|provide|update|submit|bring|pay|meet|contact|schedule)\\b/iu.test(value) || /^Je (?:(?:vais|promets de|m'engage \\u00E0) (?:envoyer|partager|relire|appeler|\\u00E9crire|pr\\u00E9parer|livrer|finir|terminer|v\\u00E9rifier|confirmer|r\\u00E9server|organiser|r\\u00E9pondre|fournir|soumettre|apporter|payer|contacter)|(?:(?:te|vous|t'|lui|leur)\\s*)?(?:enverrai|partagerai|relirai|appellerai|\\u00E9crirai|pr\\u00E9parerai|livrerai|finirai|terminerai|v\\u00E9rifierai|confirmerai|r\\u00E9serverai|organiserai|r\\u00E9pondrai|fournirai|soumettrai|apporterai|paierai|contacterai))\\b/iu.test(value);\n};const x=$input.first().json;const input=$('Read eligible authored span').first().json;const candidate=typeof x.text==='string'?JSON.parse(x.text):x;const span=input.record.authored_span;const keys=Object.keys(candidate);if(keys.length!==3||keys.some(k=>!['quote','action','suggested_due'].includes(k))||typeof candidate.quote!=='string'||typeof candidate.action!=='string'||candidate.quote!==span||!isExplicitCommitment(candidate.quote)||!candidate.quote.toLowerCase().includes(candidate.action.toLowerCase())||(candidate.suggested_due!==null&&(typeof candidate.suggested_due!=='string'||!/^\\d{4}-\\d{2}-\\d{2}$/.test(candidate.suggested_due)||!candidate.quote.includes(candidate.suggested_due))))throw new Error('unsupported or invented authored promise');return [{json:{record_key:input.record_key,content_hash:input.content_hash,candidate}}];"
      }
    },
