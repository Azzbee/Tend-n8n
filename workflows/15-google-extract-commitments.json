      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 180],
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 1 }] }
      }
    },
    {
      "id": "read-eligible-authored-span",
      "name": "Read eligible authored span",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "url": "http://host.docker.internal:18768/api/live/model-input",
        "options": { "timeout": 5000 },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": false,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_INTERNAL_API_CREDENTIAL_ID",
          "name": "CONFIGURE_INTERNAL_API_CREDENTIAL"
        }
      },
      "notes": "Bind a newly entered private Header Auth credential. No secret or real principal is included in this inactive export.",
      "notesInFlow": true
    },
    {
      "id": "check-eligible-authored-source",
      "name": "Check eligible authored source",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 0],
      "parameters": {
        "jsCode": "const x=$input.first().json;return [{json:{...x,eligible:typeof x.record_key==='string'&&x.record_key.length>0&&x.record&&typeof x.record.authored_span==='string'&&x.record.authored_span.length>0&&x.request&&Array.isArray(x.request.messages)&&x.request.messages.length>=2}}];"
      }
    },
    {
      "id": "eligible-authored-promise",
      "name": "Eligible authored promise",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [710, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ $json.eligible }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "record-extraction-attempt-before-model",
      "name": "Record extraction attempt before model",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [930, 0],
      "parameters": {
        "url": "http://host.docker.internal:18768/api/live/extraction-attempt",
        "method": "POST",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({record_key:$json.record_key,content_hash:$json.content_hash}) }}",
        "options": { "timeout": 5000 },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": false,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_INTERNAL_API_CREDENTIAL_ID",
          "name": "CONFIGURE_INTERNAL_API_CREDENTIAL"
