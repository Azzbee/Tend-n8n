{
  "id": "TendReview23",
  "name": "Tend 23: Outreach planner (fictional lane)",
  "active": false,
  "nodes": [
    {
      "id": "every-hour",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] }
      }
    },
    {
      "id": "run-fictional-demo",
      "name": "Run fictional demo",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [260, 0],
      "parameters": {}
    },
    {
      "id": "plan-outreach-quiet-hours-3-day-limit-",
      "name": "Plan outreach (quiet hours, 3-day limit)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0],
      "parameters": {
        "url": "http://host.docker.internal:18767/api/outreach/plan",
        "method": "POST",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({}) }}",
        "options": { "timeout": 10000 }
      },
      "notes": "Proposes nudges, updates, meeting follow-ups and replies from confirmed promises and meetings. Instruction-like messages are held back, never drafted."
    },
    {
      "id": "one-item-per-proposal",
      "name": "One item per proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 0],
      "parameters": {
        "jsCode": "const x=$input.first().json;if(!x||!Array.isArray(x.created))throw new Error('invalid outreach plan');return x.created.map(i=>({json:{id:i.id,request:i.request}}));"
      }
    },
    {
      "id": "local-ai-draft-ollama-cited-evidence-only-",
      "name": "Local AI draft (Ollama, cited evidence only)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 0],
      "parameters": {
        "url": "http://host.docker.internal:11434/api/chat",
        "method": "POST",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.request) }}",
        "options": { "timeout": 60000 }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "read-model-text",
      "name": "Read model text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 0],
      "parameters": {
        "jsCode": "const props=$('One item per proposal').all();return $input.all().map((it,i)=>{let text=null;try{const c=it.json&&it.json.message&&it.json.message.content;const o=typeof c==='string'?JSON.parse(c):null;if(o&&typeof o.text==='string')text=o.text.slice(0,1200);}catch(e){}return {json:{id:props[i].json.id,text}};});"
      }
    },
    {
      "id": "save-draft-if-every-detail-is-cited",
      "name": "Save draft if every detail is cited",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 0],
      "parameters": {
        "url": "http://host.docker.internal:18767/api/outreach/draft",
        "method": "POST",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": { "timeout": 10000 }
      }
    },
    {
      "id": "owner-notice",
      "name": "Owner notice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1820, 0],
      "parameters": {
        "jsCode": "const n=$input.all().length;return [{json:{chat_id:'424242',text:'Course demo • fictional data\\n'+n+' outreach draft(s) wait for your approval. Reply /outreach to review. Nothing is sent until you approve.'}}];"
      }
    },
    {
      "id": "tell-owner-on-mock-telegram",
      "name": "Tell owner on mock Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2080, 0],
      "parameters": {
        "url": "http://host.docker.internal:18767/api/mock-telegram/botFIXTURE_ONLY/sendMessage",
        "method": "POST",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": { "timeout": 10000 }
      }
    }
  ],
