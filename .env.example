# Copy to .env and fill in. .env is ignored by Git (see .gitignore); never commit it.

# PostgreSQL used by n8n for workflows, credentials and executions
POSTGRES_USER=tend
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=tend_n8n

# Encrypts the credentials n8n stores. Generate one with: openssl rand -hex 32
# Keep it: losing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-run-openssl-rand-hex-32

# Host port for the n8n editor (http://localhost:5678)
N8N_PORT=5678

GENERIC_TIMEZONE=Europe/Paris
